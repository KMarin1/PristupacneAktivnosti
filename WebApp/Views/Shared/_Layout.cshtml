@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Pristupačne Aktivnosti";
}
<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        main {
            padding-top: 1rem;
        }

        .nav-link.disabled {
            opacity: .6;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <header class="border-bottom mb-3">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container">
                <a class="navbar-brand" href="/">Pristupačne Aktivnosti</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Vidljivo svima -->
                        <li class="nav-item">
                            <a class="nav-link" href="/Aktivnosti/Index">Aktivnosti</a>
                        </li>

                        <!-- Admin-only -->
                        <li class="nav-item d-none" id="navVrste">
                            <a class="nav-link" href="/Vrste/Index">Vrste</a>
                        </li>
                        <li class="nav-item d-none" id="navPristup">
                            <a class="nav-link" href="/Pristupacnosti/Index">Pristupačnosti</a>
                        </li>
                        <li class="nav-item d-none" id="navUsers">
                            <a class="nav-link" href="/Admin/Korisnici">Korisnici</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <!-- Logged in only -->
                        <li class="nav-item d-none" id="navProfil">
                            <a class="nav-link" href="/Profil/Index">
                                <span class="me-1" id="navUserName"></span>Profil
                            </a>
                        </li>
                        <li class="nav-item d-none" id="navLogout">
                            <a class="nav-link" href="/Auth/Logout">Odjava</a>
                        </li>

                        <!-- Logged out only -->
                        <li class="nav-item" id="navLogin">
                            <a class="nav-link" href="/Auth/Login">Prijava</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle nav by auth & role
        (function(){
            const jwt  = localStorage.getItem('jwt');
            const role = (localStorage.getItem('role') || '').toLowerCase();

            const show = id => document.getElementById(id)?.classList.remove('d-none');
            const hide = id => document.getElementById(id)?.classList.add('d-none');

            const isLogged = !!jwt;
            if (isLogged) {
                // Show logged-in nav
                show('navProfil');
                show('navLogout');

                // Hide guest links
                hide('navLogin');
                hide('navRegister');

                // Username badge (optional)
                const u = localStorage.getItem('username') || '';
                if (u) { const el = document.getElementById('navUserName'); if (el) el.textContent = u + ' · '; }

                // Admin-only menus
                if (role === 'admin') {
                    show('navVrste');
                    show('navPristup');
                    show('navUsers');
                } else {
                    hide('navVrste');
                    hide('navPristup');
                    hide('navUsers');
                }
            } else {
                // Guest view
                hide('navProfil');
                hide('navLogout');
                hide('navVrste');
                hide('navUsers');
                hide('navPristup');

                show('navLogin');
                show('navRegister');
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
