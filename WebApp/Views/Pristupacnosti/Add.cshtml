@{
    ViewData["Title"] = "Dodaj Pristupačnost";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Dodaj Pristupačnost</h2>

<div id="err" class="alert alert-danger d-none"></div>

<form id="f" class="w-100" style="max-width:420px">
    <div class="mb-3">
        <label class="form-label">Naziv</label>
        <input id="naziv" class="form-control" required maxlength="120" />
    </div>
    <button class="btn btn-success">Spremi</button>
    <a href="/Pristupacnosti/Index" class="btn btn-secondary">Odustani</a>
</form>

<script>
    (function(){
      const api="https://localhost:7024";
      const t = localStorage.getItem("jwt");
      const role=(localStorage.getItem("role")||"").toLowerCase();
      if(!t || role!=="admin"){ location="/Auth/Login"; return; }

      const err=document.getElementById("err");
      const showErr=m=>{err.textContent=m;err.classList.remove("d-none");};
      const hideErr=()=>err.classList.add("d-none");

      document.getElementById("f").addEventListener("submit", async e=>{
        e.preventDefault(); hideErr();
        try{
          const body={ naziv: document.getElementById("naziv").value.trim() };
          const r=await fetch(api+"/api/Pristupacnost",{method:"POST",headers:{Authorization:"Bearer "+t,"Content-Type":"application/json"},body:JSON.stringify(body)});
          if(!r.ok){ showErr(await r.text()); return; }
          location="/Pristupacnosti/Index";
        }catch(ex){ showErr(String(ex)); }
      });
    })();
</script>
